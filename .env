# Copie para .env e preencha. Nunca versione o .env.
PORT=3000
NODE_ENV=development

# Conexão com o PostgreSQL (local ou Vercel Postgres / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academey

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-com-no-minimo-32-caracteres

# Opcional: origens extras permitidas no CORS (separadas por vírgula).
# Quando o frontend é servido pela própria API/Vercel, não é obrigatório definir.
FRONTEND_ORIGIN=http://localhost:3000,https://projeto-tsi.vercel.app

# Opcional: URL pública da aplicação para links no e-mail de recuperação de senha
APP_URL=https://projeto-tsi.vercel.app

# Opcional: envio real de e-mail via Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM=Academey UFAL <no-reply@seudominio.com>

# Use 1 se a API estiver atrás de proxy/load balancer (Nginx, Vercel, Render, etc.)
TRUST_PROXY=0
